# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=false

# Required for privileged operator API calls. Keep the real value out of Git.
FTN_API_TOKEN=replace-with-a-long-random-secret

# Optional AI adapter. No AI insight is reported unless a real adapter is configured.
GEMINI_API_KEY=

# Public application URL, if used by deployment.
APP_URL=https://your-host.example

# Durable storage. Leave empty to expose storage as not configured.
DATABASE_URL=

# Optional provider integrations. Never commit real credentials.
CLOUDFLARE_API_TOKEN=
EDGEONE_API_TOKEN=
ACME_DIRECTORY_URL=
CFSSL_CA_PATH=
CFSSL_CERT_PATH=
CFSSL_KEY_PATH=

# Optional monitoring integrations.
PROMETHEUS_URL=
ALERTMANAGER_URL=
GITHUB_TOKEN=
