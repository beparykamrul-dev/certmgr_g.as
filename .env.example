# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=false

# Required for privileged operator API calls. Generate a long random value and keep it out of Git.
FTN_API_TOKEN=replace-with-a-long-random-secret

# Optional AI provider. The API returns an explicit unavailable state when this is not configured.
GEMINI_API_KEY=

# Public application URL, if used by the deployment.
APP_URL=https://your-host.example

# Optional upstream integrations. Do not commit real credentials.
CLOUDFLARE_API_TOKEN=
DATABASE_URL=
