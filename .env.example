# FTN Cert Control runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=false

# Required for privileged operator API calls. Never commit the real value.
FTN_API_TOKEN=replace-with-a-long-random-secret

# Optional AI adapter; no AI insight is reported without a real adapter.
GEMINI_API_KEY=

APP_URL=https://your-host.example

# Durable storage / control-plane integrations
POSTGRES_DB=ftn_cert_control
POSTGRES_USER=ftn_cert_control
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://ftn_cert_control:replace-with-a-long-random-database-password@postgres:5432/ftn_cert_control
PROMETHEUS_URL=
ALERTMANAGER_URL=

# Live telemetry collectors
TRAFFIC_COLLECTOR_URL=

# Certificate lifecycle
ACME_DIRECTORY_URL=
CFSSL_CA_PATH=
CFSSL_CERT_PATH=
CFSSL_KEY_PATH=
CERTIFICATE_FILES=

# Provider / edge integrations
CLOUDFLARE_API_TOKEN=
EDGEONE_API_TOKEN=
GITHUB_TOKEN=
